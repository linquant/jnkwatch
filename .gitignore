# Build output
/firmware-esp32/build/

# Rendered frames from ./shot.sh (kept out of the repo)
*.png
# ...except the screenshots referenced by the docs
!docs/screenshots/*.png

# Editor / OS cruft
*.o
*.a
.DS_Store
*.swp
.idea/
.vscode/
compile_commands.json

# Vendor hardware docs (large binaries — kept local, not committed)
/docs/hardware/vendor/

# ESP-IDF firmware build artifacts
/firmware-esp32/firmware/build/
/firmware-esp32/firmware/managed_components/
/firmware-esp32/firmware/sdkconfig
/firmware-esp32/firmware/sdkconfig.old
/firmware-esp32/firmware/dependencies.lock

# Built APKs (binaries, not versioned)
*.apk

# Android (Gradle/Studio) build artifacts
/android-app/.gradle/
/android-app/build/
/android-app/app/build/
/android-app/local.properties
/android-app/.idea/
/android-app/*.iml
/android-app/app/*.iml
/android-app/captures/

# Battery logs pulled off the watch (firmware-esp32/tools/batlog.sh)
/firmware-esp32/logs/

# Local Claude Code MCP config (environment-specific, not shared)
/.mcp.json

# Python bytecode cache (firmware-esp32/tools/)
__pycache__/
*.pyc
